# Copy to .env next to compose.prod.yaml on the application host.
# ECR_REPOSITORY_URL is the `ecr_repository_url` output of the Terraform stack:
#   cd aws_infra && terraform output -raw ecr_repository_url
ECR_REPOSITORY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com/spotify-playlist-helpers
IMAGE_TAG=0.1-dev
